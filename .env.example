# Copy to .env for local development. Never commit a real .env or real keys.
TRADER_MODE=paper
TRADER_DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trader
TRADER_LOG_LEVEL=INFO
# Comma-separated assets (8 supported: BTC, ETH, SOL, XRP, DOGE, ADA, AVAX, LINK).
# TRADER_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD
# Strategy the daily cycle sizes: trend (default) or cross_sectional_momentum.
# TRADER_STRATEGY=trend
# Execution venue: bitstamp (default) or coinbase. Coinbase needs a key pair.
# TRADER_VENUE=bitstamp
# TRADER_COINBASE_KEY=
# TRADER_COINBASE_SECRET=
# Live order placement additionally requires this to be true. Leave unset for paper.
# TRADER_LIVE_ENABLED=false
# Ping-pong subsidy sleeve (spec W1.2b): capped maker-only BTC-USD volume
# booster toward the next Coinbase fee tier. Off by default.
# TRADER_SUBSIDY_ENABLED=false
# TRADER_SUBSIDY_TARGET_VOLUME_USD=10000
# TRADER_SUBSIDY_DAILY_CAP_USD=2000
# TRADER_SUBSIDY_ADX_MAX=20
# TRADER_SUBSIDY_ORDER_NOTIONAL_USD=250
# Ping-pong worker (spec W1.3c): levels per side (1-5), per-level offset in
# bps (level k sits spread_bps * (k + 1) off the live bid/ask), re-quote
# timer in seconds (5-300).
# TRADER_SUBSIDY_ORDER_LEVELS=2
# TRADER_SUBSIDY_SPREAD_BPS=5.0
# TRADER_SUBSIDY_REFRESH_SECONDS=20
# Autonomy Level 2 (spec W1.3): auto-approve pending plans inside both
# bounds; larger plans still wait for owner approval. Off by default.
# TRADER_AUTO_APPROVE_ENABLED=false
# TRADER_AUTO_APPROVE_MAX_NOTIONAL_USD=750
# TRADER_AUTO_APPROVE_MAX_LOSS_PCT=0.015
# Dashboard login password (spec 3.1). Required for POST /api/login.
TRADER_DASHBOARD_PASSWORD=
