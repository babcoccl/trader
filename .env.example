# Copy to .env for local development. Never commit a real .env or real keys.
TRADER_MODE=paper
TRADER_DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trader
TRADER_LOG_LEVEL=INFO
# Comma-separated assets (8 supported: BTC, ETH, SOL, XRP, DOGE, ADA, AVAX, LINK).
# TRADER_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD
# Strategy the daily cycle sizes: trend (default) or cross_sectional_momentum.
# TRADER_STRATEGY=trend
# Execution venue: bitstamp (default) or coinbase. Coinbase needs a key pair.
# TRADER_VENUE=bitstamp
# TRADER_COINBASE_KEY=
# TRADER_COINBASE_SECRET=
# Live order placement additionally requires this to be true. Leave unset for paper.
# TRADER_LIVE_ENABLED=false
# Dashboard login password (spec 3.1). Required for POST /api/login.
TRADER_DASHBOARD_PASSWORD=
